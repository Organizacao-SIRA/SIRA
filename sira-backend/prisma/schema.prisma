// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String               @id @default(uuid())
  email                 String               @unique
  password              String
  name                  String?
  course                String?
  educationLevel        String?
  mainArea              String?
  subAreas              String?
  languages             String[]
  materialLevels        String[]
  wantsBooks            Boolean              @default(true)
  wantsArticles         Boolean              @default(true)
  interests             String[]
  academicGoal          String?
  avatarUrl             String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  favorites             Favorite[]
  searchHistory         SearchHistory[]
  recommendationCache   RecommendationCache?
  passwordResetTokens   PasswordResetToken[]
}

model RecommendationCache {
  userId      String   @id
  items       Json
  basedOn     Json
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Material {
  id              String     @id
  type            String // 'article', 'book', etc.
  title           String
  authors         String
  year            String
  source          String
  provider        String? // 'Google Books' | 'Semantic Scholar' | 'OpenAlex'
  relevance       Int        @default(0)
  abstract        String?
  image           String?
  url             String?
  thematicArea    String?
  doi             String?
  isbn            String?
  level           String? // 'Introdutório', 'Intermediário', 'Avançado'
  aiJustification String?
  favorites       Favorite[]
  createdAt       DateTime   @default(now())
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  materialId String
  user       User     @relation(fields: [userId], references: [id])
  material   Material @relation(fields: [materialId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, materialId])
}

model RecommendationEvent {
  id         String   @id @default(uuid())
  userId     String
  materialId String
  eventType  String   // 'impression' | 'click' | 'favorite'
  createdAt  DateTime @default(now())

  @@index([userId, eventType])
  @@index([materialId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
