# Configurações do Banco de Dados (PostgreSQL)
POSTGRES_USER=sira_user
POSTGRES_PASSWORD=sira_password
POSTGRES_DB=sira_db

# URL de conexão com o banco (o Postgres roda em container via docker compose,
# exposto em localhost:5433). Backend e frontend rodam localmente.
DATABASE_URL="postgresql://sira_user:sira_password@localhost:5433/sira_db?schema=public"

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Segurança (JWT)
JWT_SECRET="mude_isso_em_producao_123456"
# IA — Anthropic (obrigatório para busca conversacional e ranking)
ANTHROPIC_API_KEY=""

# IA — Google Gemini (opcional: fallback automático se o Claude estiver indisponível)
GEMINI_API_KEY=""

# APIs Acadêmicas (opcionais: aumentam os limites de requisição)
GOOGLE_BOOKS_API_KEY=""
SEMANTIC_SCHOLAR_API_KEY=""
# OpenAlex usa mailto para acesso ao polite pool (maior rate limit), não requer chave
OPENALEX_MAILTO=""

# Cache em memória dos resultados de busca de materiais (LRU + TTL)
# Defaults seguros se ausentes: 200 entradas, 3600s (1h).
MATERIALS_CACHE_MAX_ITEMS="200"
MATERIALS_CACHE_TTL_SECONDS="3600"

# Cloudinary (upload de avatares)
# AVATAR_STORAGE_DRIVER pode ser "local" ou "cloudinary".
# Se vazio: usa Cloudinary quando configurado; em desenvolvimento sem Cloudinary, usa storage local.
AVATAR_STORAGE_DRIVER=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# CORS — origens permitidas (separadas por vírgula; padrão: http://localhost:5173)
ALLOWED_ORIGINS=""

# URL do Frontend (para links de recuperação de senha)
FRONTEND_URL="http://localhost:5173"

# E-mail via Brevo (https://brevo.com — gratuito, 300 e-mails/dia, sem SMTP)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""   # E-mail verificado no Brevo (ex: seuemail@gmail.com)
