# Configurações do Banco de Dados (PostgreSQL)
POSTGRES_USER=sira_user
POSTGRES_PASSWORD=sira_password
POSTGRES_DB=sira_db
# URL para uso local (fora do Docker):
DATABASE_URL="postgresql://sira_user:sira_password@localhost:5432/sira_db?schema=public"

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Segurança (JWT)
JWT_SECRET="mude_isso_em_producao_123456"
JWT_EXPIRES_IN="7d"

# APIs Externas (Obrigatório para funcionalidades de busca)
GOOGLE_BOOKS_API_KEY=""
# SEMANTIC_SCHOLAR_API_KEY=""
ANTHROPIC_API_KEY=""
