<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
</head>
<body style="margin:0;padding:0;background:#f0f2f5;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f0f2f5;padding:40px 16px;">
    <tr>
      <td align="center">
        <table width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;">

          <!-- Header -->
          <tr>
            <td style="background:#1351B4;padding:36px 48px;border-radius:8px 8px 0 0;text-align:center;">
              <span style="font-size:36px;font-weight:900;letter-spacing:-1px;line-height:1;">
                <span style="color:#ffffff;">SIRA</span><span style="color:#FFCD07;">+</span>
              </span>
              <br />
              <span style="font-size:12px;color:rgba(255,255,255,0.75);letter-spacing:0.5px;text-transform:uppercase;">{{tagline}}</span>
            </td>
          </tr>

          <!-- Card principal -->
          <tr>
            <td style="background:#ffffff;padding:48px 48px 40px;">

              <!-- Conteúdo -->
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td>
                    <p style="margin:0 0 6px;font-size:12px;font-weight:700;color:#1351B4;letter-spacing:1.5px;text-transform:uppercase;">{{eyebrow}}</p>
                    <h1 style="margin:0 0 16px;font-size:24px;font-weight:800;color:#003157;line-height:1.3;">{{title}}</h1>
                    <p style="margin:0 0 32px;font-size:15px;color:#6b7280;line-height:1.7;">
                      {{greeting}} <strong style="color:#1f2937;">{{name}}</strong>. {{intro}}
                    </p>
                  </td>
                </tr>

                <!-- Botão -->
                <tr>
                  <td align="center" style="padding-bottom:32px;">
                    <a href="{{resetLink}}"
                       style="display:inline-block;background:#1351B4;color:#ffffff;text-decoration:none;padding:16px 48px;border-radius:8px;font-size:15px;font-weight:700;letter-spacing:0.3px;">
                      {{button}}
                    </a>
                  </td>
                </tr>

                <!-- Aviso de expiração -->
                <tr>
                  <td style="padding-bottom:24px;">
                    <table width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="background:#fffbeb;border-left:3px solid #FFCD07;border-radius:0 6px 6px 0;padding:12px 16px;">
                          <p style="margin:0;font-size:13px;color:#92400e;line-height:1.5;">
                            {{expiration}} <strong>{{expirationStrong}}</strong> {{expirationSuffix}}
                          </p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Aviso de segurança -->
                <tr>
                  <td style="padding-bottom:32px;">
                    <p style="margin:0;font-size:13px;color:#9ca3af;line-height:1.6;">
                      {{security}}
                    </p>
                  </td>
                </tr>

                <!-- Divisor -->
                <tr>
                  <td style="border-top:1px solid #f3f4f6;padding-bottom:20px;font-size:0;">&nbsp;</td>
                </tr>

                <!-- Link alternativo -->
                <tr>
                  <td>
                    <p style="margin:0 0 6px;font-size:11px;color:#9ca3af;line-height:1.5;">
                      {{fallback}}
                    </p>
                    <p style="margin:0;font-size:11px;color:#1351B4;word-break:break-all;line-height:1.5;">
                      {{resetLink}}
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background:#f9fafb;padding:20px 48px;border-top:1px solid #e5e7eb;border-radius:0 0 8px 8px;text-align:center;">
              <p style="margin:0;font-size:11px;color:#9ca3af;line-height:1.5;">
                &copy; {{year}} SIRA+ &mdash; {{footer}}
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
